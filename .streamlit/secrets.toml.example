# Copy this file to .streamlit/secrets.toml for LOCAL runs (that file is git-ignored).
# On Streamlit Community Cloud, paste these lines into: App settings > Secrets.

GROQ_API_KEY = "gsk_paste_your_key_here"

# Optional: override the model. Default is openai/gpt-oss-20b, with openai/gpt-oss-120b as fallback.
# GROQ_MODEL = "openai/gpt-oss-20b"
